# ── Core ─────────────────────────────────────────────────────
APP_ENV=production                 # production refuses to boot on weak/missing secrets
PORT=8080
BASE_URL=https://spendmux.example  # public URL; OAuth callbacks and links derive from it
DATABASE_URL=postgres://spendmux:URL_ENCODED_PASSWORD@postgres:5432/spendmux?sslmode=disable
POSTGRES_PASSWORD=REPLACE_WITH_a_random_database_password   # docker-compose only

# Secrets — generate each with: openssl rand -base64 32 (all must differ)
COOKIE_SECRET=REPLACE_WITH_openssl_rand_base64_32           # sessions, email hashes
KEY_ENCRYPTION_SECRET=REPLACE_WITH_a_separate_base64_32     # server layer over the vault; losing it loses the vault
# Vault keypair: browsers seal provider keys with its public half; the server unwraps per request.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out /etc/spendmux/vault.pem
# Mount it read-only and point at it (or paste the PEM into VAULT_PRIVATE_KEY). Losing it loses sealed keys.
VAULT_PRIVATE_KEY_FILE=/run/secrets/vault.pem
METRICS_TOKEN=REPLACE_WITH_a_random_metrics_bearer_token    # protects /metrics (24+ chars)

# ── Sign-in (at least one provider). Callback: ${BASE_URL}/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Override a callback only if the console has a different path registered:
# GOOGLE_CALLBACK_URL=https://spendmux.example/oauth/google/callback

# ── Legal pages ──────────────────────────────────────────────
LEGAL_ENTITY=
SUPPORT_EMAIL=

# ── Proxy behaviour ──────────────────────────────────────────
SPENDMUX_API_RATE_LIMIT_REQUESTS=30        # per platform token; 0 disables
SPENDMUX_API_RATE_LIMIT_WINDOW_SECONDS=60
SPENDMUX_LOOP_MAX=25                       # identical prompts / window on one token; 0 disables
SPENDMUX_LOOP_WINDOW_SECONDS=300
SPENDMUX_ALLOW_PRIVATE_UPSTREAMS=false     # true to reach a local Ollama/vLLM; keep false if others can sign in (SSRF boundary)
SPENDMUX_ENABLE_LOCAL_IP_RATE_LIMIT=false  # in-process browser limiter; use the edge in production
SPENDMUX_MAX_INFLIGHT_PER_TOKEN=32         # bulkhead: concurrent /v1 requests per token (per replica); 0 disables
SPENDMUX_DEBUG=0

# ── Runtime tuning ───────────────────────────────────────────
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800
UPSTREAM_REQUEST_TIMEOUT_SECONDS=120          # non-streaming calls
UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=90       # streams: cancel after this long with no bytes
UPSTREAM_STREAM_MAX_SECONDS=1800              # streams: hard ceiling per generation

# Opt-in conversation memory (X-Spendmux-Memory)
MEMORY_CONTEXT_CHARS=48000     # history sent upstream per call (~12k tokens)
MEMORY_MAX_MESSAGES=200        # stored per thread
MEMORY_TTL_DAYS=30             # idle threads are deleted
UPSTREAM_RESPONSE_HEADER_TIMEOUT_SECONDS=30
UPSTREAM_MAX_ATTEMPTS=2                      # same-key retries; skipped when another key can take the call
PROVIDER_KEY_MAX_ATTEMPTS=3                  # keys tried per provider before giving up (see README)
UPSTREAM_CIRCUIT_FAILURES=5
UPSTREAM_CIRCUIT_COOLDOWN_SECONDS=30
UPSTREAM_MAX_CONNS_PER_HOST=256            # bulkhead: sockets one provider host may hold
SPENDMUX_HOST=spendmux.example             # Traefik router host (docker-compose.production.yml)
ACME_EMAIL=ops@spendmux.example            # Let's Encrypt account email (certificate expiry notices)
# Optional: a dedicated API hostname, and the base_url pages show to users.
# SPENDMUX_API_HOST=api.spendmux.example
# SPENDMUX_API_URL=https://api.spendmux.example

# ── Backups (optional: docker compose --profile backup) ──────
# BACKUP_REMOTE=b2:my-bucket/spendmux
# BACKUP_AGE_RECIPIENT=age1...               # age-keygen public key; private key stays off the server
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# BACKUP_AT=03:00
# BACKUP_KEEP_DAYS=30
# BACKUP_PING_URL=                           # optional healthchecks.io-style URL
